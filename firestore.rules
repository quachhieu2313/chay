rules_version = '2';
// Dán vào Firebase console → Firestore Database → Rules → Publish.
// Thay 2 email bên dưới bằng email Google của Hiếu và của vợ (chỉ sửa trên console, KHÔNG commit email thật lên GitHub).
service cloud.firestore {
  match /databases/{database}/documents {
    function nguoiNha() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['EMAIL_CUA_HIEU@gmail.com', 'EMAIL_CUA_VO@gmail.com'];
    }
    match /{collection}/{docId} {
      allow read, write: if nguoiNha()
        && collection in ['people', 'workouts', 'events', 'chores', 'meals', 'habits'];
    }
    // Ứng dụng Lịch chạy cá nhân (tap/): ai đăng nhập Google cũng dùng được,
    // nhưng chỉ đọc/ghi/xoá được tài liệu của chính mình (runners/<uid>).
    match /runners/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['s', 'v', 't'])
        && request.resource.data.s is string
        && request.resource.data.s.size() < 500000
        && request.resource.data.v is int;
    }
  }
}
